---
import '@fontsource-variable/jetbrains-mono/wght-italic.css';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { perfil, projetos } from '../data/perfil';

const atalhos = projetos.filter((p) => p.url.trim() !== '').slice(0, 3);
---

<Layout titulo={`Página não encontrada · ${perfil.nome}`} descricao="Essa página não existe. Os projetos continuam no início." indexar={false}>
  <main class="erro">
    <p class="codigo" aria-hidden="true">404</p>
    <p class="selo">Página não encontrada</p>
    <h1 class="titulo">Esse link saiu da <em>órbita.</em></h1>
    <p class="texto">O endereço pode estar errado ou a página mudou de lugar. Os projetos continuam no início.</p>

    <a class="botao" href="/">
      <Icon nome="voltar" tamanho={14} />
      Voltar para o início
    </a>

    {
      atalhos.length > 0 && (
        <nav class="atalhos" aria-label="Projetos">
          <span>Ou vá direto para</span>
          <ul>
            {atalhos.map((p) => (
              <li>
                <a href={p.url}>{p.nome}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </main>
</Layout>

<style>
  .erro {
    min-height: 100dvh;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-12) var(--gutter);
    text-align: center;
  }

  em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }

  .codigo {
    font-size: clamp(120px, 34vw, 280px);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--accent) 45%, transparent);
    text-shadow: 0 0 60px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .selo {
    margin-top: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
  }

  .titulo {
    font-size: clamp(40px, 10vw, 76px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .texto {
    max-width: 44ch;
    color: var(--text-2);
    text-wrap: balance;
  }

  .botao {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 40px;
    margin-top: var(--space-4);
    padding: 0 var(--space-5);
    border-radius: var(--r);
    background: var(--accent);
    color: var(--page);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 0 28px -6px color-mix(in srgb, var(--accent) 60%, transparent);
    transition: box-shadow 200ms var(--ease-out);
  }

  .atalhos {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-size: 14px;
    color: var(--text-3);
  }

  .atalhos ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
  }

  .atalhos a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
    text-underline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .botao:hover {
      box-shadow: 0 0 36px -4px color-mix(in srgb, var(--accent) 70%, transparent);
    }

    .atalhos a:hover {
      text-decoration-color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .botao {
      transition: none;
    }
  }
</style>
