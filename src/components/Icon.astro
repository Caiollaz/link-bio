---
interface Props {
  nome: 'linkedin' | 'github' | 'instagram' | 'seta' | 'voltar' | 'sol' | 'lua';
  tamanho?: number;
  class?: string;
}

const { nome, tamanho = 20, class: classe } = Astro.props;
const caixa = nome === 'seta' || nome === 'voltar' ? '0 0 16 16' : '0 0 24 24';
---

<svg class={classe} viewBox={caixa} width={tamanho} height={tamanho} aria-hidden="true" focusable="false">
  {
    nome === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M8 10.5V17M8 7.5v.01M12 17v-6.5M12 13.5a2.5 2.5 0 0 1 5 0V17" />
      </>
    )
  }
  {
    nome === 'github' && (
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4M9 18c-4.51 2-5-2-7-2" />
    )
  }
  {
    nome === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.5 6.5v.01" />
      </>
    )
  }
  {nome === 'seta' && <path d="M5 11 11 5M6 5h5v5" />}
  {nome === 'voltar' && <path d="M10 3 5 8l5 5" />}
  {
    nome === 'sol' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </>
    )
  }
  {nome === 'lua' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />}
</svg>
